async def db_update_appeal(appeal_id, **kwargs):
    if not kwargs:
        return
    sets = ", ".join(f"{k}=?" for k in kwargs)
    vals = list(kwargs.values()) + [now_str(), appeal_id]
    async with mdb() as db:
        await db.execute(f"UPDATE appeals SET {sets}, updated_at=? WHERE id=?", vals)
        await db.commit()

