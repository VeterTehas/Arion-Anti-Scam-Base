async def get_staff_counts():
    counts = {"moderator": 0, "reviewer": 0, "appeal_reviewer": 0}
    async with mdb() as db:
        cur = await db.execute("SELECT role, COUNT(*) as cnt FROM staff GROUP BY role")
        for row in await cur.fetchall():
            if row["role"] in ("moderator", "admin", "head_admin"):
                counts["moderator"] += row["cnt"]
            elif row["role"] == "reviewer":
                counts["reviewer"] += row["cnt"]
    counts["appeal_reviewer"] = counts["reviewer"]
    return counts

