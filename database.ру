async def inc_stat(key, delta=1):
    async with mdb() as db:
        cur = await db.execute("SELECT stat_value FROM system_stats WHERE stat_key=?", (key,))
        row = await cur.fetchone()
        val = int(row[0]) if row else 0
        await db.execute(
            "INSERT OR REPLACE INTO system_stats (stat_key, stat_value, updated_at) VALUES (?, ?, ?)",
            (key, str(val + delta), now_str())
        )
        await db.commit()

async def get_all_stats():
    result = {}
    async with mdb() as db:
        cur = await db.execute("SELECT stat_key, stat_value FROM system_stats")
        for row in await cur.fetchall():
            result[row["stat_key"]] = int(row["stat_value"])
    return result

