async def start_api_server():
    from aiohttp import web
    from api_server import setup_routes
    app = web.Application()
    setup_routes(app)
    runner = web.AppRunner(app)
    await runner.setup()
    await web.TCPSite(runner, "0.0.0.0", API_PORT).start()
    logger.info(f"✅ HTTP API запущен на порту {API_PORT}")

async def auto_unban_task():
    from database import get_expired_bans, remove_ban
    while True:
        await asyncio.sleep(3600)
        try:
            expired = await get_expired_bans()
            for user_id, chat_id in expired:
                try:
                    from aiogram import Bot
                    bot = Bot(token=BOT_TOKEN)
                    await bot.unban_chat_member(chat_id, user_id)
                    await remove_ban(user_id, chat_id)
                    logger.info(f"Auto-unbanned {user_id} in {chat_id}")
                except Exception as e:
                    logger.error(f"Auto-unban error: {e}")
        except Exception as e:
            logger.error(f"Auto-unban task error: {e}")

async def main():
    logger.info(DESIGN_HEADER)
    logger.info("💎 Arion ScamBase v14.3 — модульная версия")

    await init_db()
    logger.info("✅ База данных инициализирована")

    asyncio.create_task(start_api_server())
    asyncio.create_task(auto_unban_task())

    bot = Bot(token=BOT_TOKEN)
    await set_commands(bot)

    dp = Dispatcher(storage=MemoryStorage())
    dp.include_router(router)

    logger.info("🟢 БОТ ЗАПУЩЕН")
    try:
        await dp.start_polling(bot)
    except KeyboardInterrupt:
        logger.info("🔴 Бот остановлен")
    finally:
        await bot.session.close()

if __name__ == "__main__":
    asyncio.run(main())
