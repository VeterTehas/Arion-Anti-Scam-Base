def other_bases_keyboard(identifier):
    items = list(OTHER_BOTS.items())
    rows = []
    for i in range(0, len(items), 2):
        rows.append([InlineKeyboardButton(text=f"🔍 {name}", url=f"https://t.me/{username}?start=check_{identifier}") for name, username in items[i:i+2]])
    return InlineKeyboardMarkup(inline_keyboard=rows)

